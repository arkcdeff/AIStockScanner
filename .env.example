APP_NAME=AI Stock Scanner
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Replace username/password when needed.
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/ai_stock_scanner
DATABASE_URL_SYNC=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/ai_stock_scanner
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# EOD pipeline scheduler (defaults; scheduler is disabled unless enabled)
EOD_SCHEDULER_ENABLED=false
EOD_SCHEDULER_TIMEZONE=Asia/Kolkata
EOD_SCHEDULER_HOUR=18
EOD_SCHEDULER_MINUTE=30
EOD_SCHEDULER_MAX_INSTANCES=1
EOD_SCHEDULER_COALESCE=true

# AI Explanation Engine (provider abstraction)
# Supported providers: mock | ollama | deepseek | openai
# mock is deterministic and never makes network calls (safe default).
AI_PROVIDER=mock
AI_ENABLED=true
AI_TIMEOUT=60
AI_CACHE_TTL=3600

# Ollama (local, no API key)
AI_OLLAMA_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.1

# DeepSeek (requires API key)
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=deepseek-chat
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (requires API key)
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_BASE_URL=https://api.openai.com/v1

# Notification providers (provider abstraction)
# Supported providers: mock | telegram | email | in_app
# mock is deterministic and never makes network calls (safe default).
NOTIFICATION_PROVIDER=mock
NOTIFICATION_TIMEOUT=15

# Notification delivery service / retry
NOTIFICATIONS_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_MINUTES=15
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_STALE_MINUTES=30

# Notification delivery scheduler (disabled by default)
NOTIFICATION_DELIVERY_JOB_ENABLED=false
NOTIFICATION_DELIVERY_INTERVAL_MINUTES=5
NOTIFICATION_DELIVERY_MAX_INSTANCES=1
NOTIFICATION_DELIVERY_COALESCE=true

# Daily notification summary scheduler (weekdays; disabled by default)
DAILY_SUMMARY_ENABLED=false
DAILY_SUMMARY_HOUR=20
DAILY_SUMMARY_MINUTE=0
DAILY_SUMMARY_TIMEZONE=Asia/Kolkata
DAILY_SUMMARY_MAX_INSTANCES=1
DAILY_SUMMARY_COALESCE=true

# Telegram (requires bot token; see @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_HTML_MODE=true
TELEGRAM_MAX_MESSAGE_LENGTH=4096

# Email / SMTP
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=false
EMAIL_USE_STARTTLS=true
EMAIL_TIMEOUT=15

# Authentication core
# Required before issuing tokens. Use at least 32 random characters.
# For rotation, list active first: current:<secret>,previous:<secret>
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_HASH_SCHEME=argon2id
CLOCK_SKEW_SECONDS=30

# Browser authentication UI (cookies + CSRF)
# Cookies are HttpOnly SameSite cookies; never use localStorage for tokens.
# Set AUTH_COOKIE_SECURE=true behind HTTPS in production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=x-csrf-token
# Optional dedicated secret for CSRF signing. When blank, JWT_SECRET_KEY is reused.
CSRF_SECRET_KEY=
