APP_NAME=AI Stock Scanner
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Replace username/password when needed.
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/ai_stock_scanner
DATABASE_URL_SYNC=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/ai_stock_scanner
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# EOD pipeline scheduler (defaults; scheduler is disabled unless enabled)
EOD_SCHEDULER_ENABLED=false
EOD_SCHEDULER_TIMEZONE=Asia/Kolkata
EOD_SCHEDULER_HOUR=18
EOD_SCHEDULER_MINUTE=30
EOD_SCHEDULER_MAX_INSTANCES=1
EOD_SCHEDULER_COALESCE=true

# AI Explanation Engine (provider abstraction)
# Supported providers: mock | ollama | deepseek | openai
# mock is deterministic and never makes network calls (safe default).
AI_PROVIDER=mock
AI_ENABLED=true
AI_TIMEOUT=60
AI_CACHE_TTL=3600

# Ollama (local, no API key)
AI_OLLAMA_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.1

# DeepSeek (requires API key)
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=deepseek-chat
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (requires API key)
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_BASE_URL=https://api.openai.com/v1

# Notification providers (provider abstraction)
# Supported providers: mock | telegram | email | in_app
# mock is deterministic and never makes network calls (safe default).
NOTIFICATION_PROVIDER=mock
NOTIFICATION_TIMEOUT=15

# Notification delivery service / retry
NOTIFICATIONS_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_MINUTES=15
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_STALE_MINUTES=30

# Telegram (requires bot token; see @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_HTML_MODE=true
TELEGRAM_MAX_MESSAGE_LENGTH=4096

# Email / SMTP
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=false
EMAIL_USE_STARTTLS=true
EMAIL_TIMEOUT=15
